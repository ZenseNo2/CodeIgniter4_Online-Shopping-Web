#--------------------------------------------------------------------
# ShopEase - konfigurasi lingkungan
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

# app.baseURL sengaja dikosongkan: alamat dideteksi otomatis untuk
#   - php spark serve          -> http://localhost:8080/
#   - XAMPP htdocs/shopease     -> http://localhost/shopease/public/
# Isi baris di bawah HANYA bila aplikasi diakses lewat domain/IP lain.
# app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE (MySQL / MariaDB bawaan XAMPP / Laragon)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = db_shopease
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
